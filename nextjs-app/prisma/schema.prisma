generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model SiteSettings {
  id             String   @id @default(cuid())
  siteName       String   @default("Dola Foundation")
  tagline        String   @default("Empowering Lives")
  logoUrl        String?
  faviconUrl          String?
  announcementText    String?
  announcementEnabled Boolean  @default(true)
  heroTitle      String   @default("Empowering Lives, Inspiring Hope")
  heroSubtitle   String   @default("We work to uplift communities through education, healthcare, and sustainable development across Bangladesh.")
  heroImage      String?
  aboutText      String?  @db.Text
  missionText    String?  @db.Text
  visionText     String?  @db.Text
  founderName    String?
  founderMessage String?  @db.Text
  founderImage   String?
  address        String?
  phone          String?
  email          String?
  facebookUrl    String?
  instagramUrl   String?
  twitterUrl     String?
  youtubeUrl     String?
  primaryColor   String   @default("#0F3D8C")
  accentColor    String   @default("#F4B400")
  secondaryColor String   @default("#1F9D55")
  aboutBannerImage     String?
  programsBannerImage  String?
  projectsBannerImage  String?
  contactBannerImage   String?
  stat1Label     String   @default("Lives Impacted")
  stat1Value     String   @default("5000")
  stat2Label     String   @default("Active Programs")
  stat2Value     String   @default("12")
  stat3Label     String   @default("Districts Reached")
  stat3Value     String   @default("8")
  stat4Label     String   @default("Volunteers")
  stat4Value     String   @default("500")
  updatedAt      DateTime @updatedAt
}

model Video {
  id          String   @id @default(cuid())
  title       String
  youtubeUrl  String
  description String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Program {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @db.Text
  objectives  String[]
  icon        String?
  bannerImage String?
  gallery     String[]
  stat1Label  String?
  stat1Value  String?
  stat2Label  String?
  stat2Value  String?
  stat3Label  String?
  stat3Value  String?
  order       Int        @default(0)
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  donations   Donation[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @db.Text
  budget      Decimal?
  location    String?
  gallery     String[]
  impact      String?       @db.Text
  status      ProjectStatus @default(ONGOING)
  startDate   DateTime?
  endDate     DateTime?
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  category    String?
  tags        String[]
  author      String    @default("Dola Foundation")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  url       String
  publicId  String?
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?  @db.Text
  image     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  quote     String   @db.Text
  program   String?
  image     String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Volunteer {
  id           String          @id @default(cuid())
  fullName     String
  email        String
  phone        String
  address      String?
  profession   String?
  skills       String[]
  interest     String[]
  availability String?
  message      String?         @db.Text
  status       VolunteerStatus @default(PENDING)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
}

model Donor {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  phone      String?
  address    String?
  totalGiven Decimal    @default(0)
  donations  Donation[]
  createdAt  DateTime   @default(now())
}

model Donation {
  id            String         @id @default(cuid())
  donorName     String
  donorEmail    String
  donorPhone    String?
  amount        Decimal
  currency      String         @default("BDT")
  method        PaymentMethod
  transactionId String?
  programId     String?
  program       Program?       @relation(fields: [programId], references: [id])
  status        DonationStatus @default(PENDING)
  isRecurring   Boolean        @default(false)
  frequency     String?
  message       String?
  donorId       String?
  donor         Donor?         @relation(fields: [donorId], references: [id])
  createdAt     DateTime       @default(now())
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  STRIPE
  PAYPAL
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
