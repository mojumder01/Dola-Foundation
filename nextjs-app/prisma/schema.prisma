generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model SiteSettings {
  id             String   @id @default(cuid())
  siteName       String   @default("Dola Foundation")
  siteNameBn     String?
  tagline        String   @default("Empowering Lives")
  taglineBn      String?
  logoUrl        String?
  faviconUrl          String?
  announcementText    String?
  announcementTextBn  String?
  announcementEnabled Boolean  @default(true)
  heroTitle      String   @default("Empowering Lives, Inspiring Hope")
  heroTitleBn    String?
  heroSubtitle   String   @default("We work to uplift communities through education, healthcare, and sustainable development across Bangladesh.")
  heroSubtitleBn String?  @db.Text
  heroImage      String?
  aboutText      String?  @db.Text
  aboutTextBn    String?  @db.Text
  missionText    String?  @db.Text
  missionTextBn  String?  @db.Text
  visionText     String?  @db.Text
  visionTextBn   String?  @db.Text
  founderName    String?
  founderNameBn  String?
  founderMessage String?  @db.Text
  founderMessageBn String? @db.Text
  founderImage   String?
  address        String?
  phone          String?
  email          String?
  facebookUrl    String?
  instagramUrl   String?
  twitterUrl     String?
  youtubeUrl     String?
  primaryColor   String   @default("#0F3D8C")
  accentColor    String   @default("#F4B400")
  secondaryColor String   @default("#1F9D55")
  aboutBannerImage     String?
  programsBannerImage  String?
  projectsBannerImage  String?
  contactBannerImage   String?
  volunteerBannerImage String?
  blogBannerImage      String?
  galleryBannerImage   String?
  donateBannerImage    String?
  googleMapsEmbedUrl   String?
  donatePageTitle      String?
  donatePageTitleBn    String?
  donatePageSubtitle   String?  @db.Text
  donatePageSubtitleBn String?  @db.Text
  volunteerPageBadge      String?
  volunteerPageBadgeBn    String?
  volunteerPageTitle      String?
  volunteerPageTitleBn    String?
  volunteerPageSubtitle   String?  @db.Text
  volunteerPageSubtitleBn String?  @db.Text
  volunteerWhyHeading     String?
  volunteerWhyHeadingBn   String?
  volunteerWhyDescription String?  @db.Text
  volunteerWhyDescriptionBn String? @db.Text
  volunteerHowHeading     String?
  volunteerHowHeadingBn   String?
  volunteerApplyHeading   String?
  volunteerApplyHeadingBn String?
  volunteerApplySubtitle  String?  @db.Text
  volunteerApplySubtitleBn String? @db.Text
  officeHours          String?
  footerMissionText    String?  @db.Text
  footerMissionTextBn  String?  @db.Text
  homeStatsBadge          String?
  homeStatsBadgeBn        String?
  homeStatsTitle          String?
  homeStatsTitleBn        String?
  programsSectionBadge    String?
  programsSectionBadgeBn  String?
  programsSectionTitle    String?
  programsSectionTitleBn  String?
  programsSectionSubtitle String?  @db.Text
  programsSectionSubtitleBn String? @db.Text
  projectsSectionBadge    String?
  projectsSectionBadgeBn  String?
  projectsSectionTitle    String?
  projectsSectionTitleBn  String?
  projectsSectionSubtitle String?  @db.Text
  projectsSectionSubtitleBn String? @db.Text
  storiesSectionBadge     String?
  storiesSectionBadgeBn   String?
  storiesSectionTitle     String?
  storiesSectionTitleBn   String?
  storiesSectionSubtitle  String?  @db.Text
  storiesSectionSubtitleBn String? @db.Text
  gallerySectionBadge     String?
  gallerySectionBadgeBn   String?
  gallerySectionTitle     String?
  gallerySectionTitleBn   String?
  gallerySectionSubtitle  String?  @db.Text
  gallerySectionSubtitleBn String? @db.Text
  videoSectionBadge       String?
  videoSectionBadgeBn     String?
  videoSectionTitle       String?
  videoSectionTitleBn     String?
  videoSectionSubtitle    String?  @db.Text
  videoSectionSubtitleBn  String?  @db.Text
  homeVolunteerCtaBadge      String?
  homeVolunteerCtaBadgeBn    String?
  homeVolunteerCtaTitle      String?
  homeVolunteerCtaTitleBn    String?
  homeVolunteerCtaSubtitle   String?  @db.Text
  homeVolunteerCtaSubtitleBn String?  @db.Text
  homeDonationCtaBadge       String?
  homeDonationCtaBadgeBn     String?
  homeDonationCtaTitleLine1  String?
  homeDonationCtaTitleLine1Bn String?
  homeDonationCtaTitleLine2  String?
  homeDonationCtaTitleLine2Bn String?
  homeDonationCtaSubtitle    String?  @db.Text
  homeDonationCtaSubtitleBn  String?  @db.Text
  sectionOrder   String   @default("stats,programs,projects,testimonials,gallery,video,volunteer,donation")
  stat1Label     String   @default("Lives Impacted")
  stat1LabelBn   String?
  stat1Value     String   @default("5000")
  stat2Label     String   @default("Active Programs")
  stat2LabelBn   String?
  stat2Value     String   @default("12")
  stat3Label     String   @default("Districts Reached")
  stat3LabelBn   String?
  stat3Value     String   @default("8")
  stat4Label     String   @default("Volunteers")
  stat4LabelBn   String?
  stat4Value     String   @default("500")
  aboutStat1Icon  String  @default("🏛️")
  aboutStat1Value String  @default("2015")
  aboutStat1Label String  @default("Founded")
  aboutStat1LabelBn String?
  aboutStat2Icon  String  @default("❤️")
  aboutStat2Value String  @default("5,000+")
  aboutStat2Label String  @default("Lives Impacted")
  aboutStat2LabelBn String?
  aboutStat3Icon  String  @default("📍")
  aboutStat3Value String  @default("8")
  aboutStat3Label String  @default("Districts Served")
  aboutStat3LabelBn String?
  aboutStat4Icon  String  @default("👥")
  aboutStat4Value String  @default("500+")
  aboutStat4Label String  @default("Volunteers")
  aboutStat4LabelBn String?
  updatedAt      DateTime @updatedAt
}

model Video {
  id          String   @id @default(cuid())
  title       String
  titleBn     String?
  youtubeUrl  String
  description String?
  descriptionBn String?
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Program {
  id          String     @id @default(cuid())
  title       String
  titleBn     String?
  slug        String     @unique
  description     String     @db.Text
  descriptionBn   String?    @db.Text
  longDescription String?    @db.Text
  longDescriptionBn String?  @db.Text
  objectives      String[]
  icon        String?
  bannerImage String?
  videoUrl    String?
  videoPriority String   @default("image")
  gallery     String[]
  stat1Label  String?
  stat1LabelBn String?
  stat1Value  String?
  stat2Label  String?
  stat2LabelBn String?
  stat2Value  String?
  stat3Label  String?
  stat3LabelBn String?
  stat3Value  String?
  order       Int        @default(0)
  published   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  donations   Donation[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  titleBn     String?
  slug        String        @unique
  description String        @db.Text
  descriptionBn String?     @db.Text
  budget      Decimal?
  location    String?
  gallery     String[]
  videoUrl    String?
  videoPriority String      @default("image")
  impact      String?       @db.Text
  impactBn    String?       @db.Text
  status      ProjectStatus @default(ONGOING)
  startDate   DateTime?
  endDate     DateTime?
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  titleBn     String?
  slug        String    @unique
  excerpt     String?
  excerptBn   String?
  content     String    @db.Text
  contentBn   String?   @db.Text
  coverImage  String?
  videoUrl    String?
  videoPriority String  @default("image")
  category    String?
  categoryBn  String?
  tags        String[]
  author      String    @default("Dola Foundation")
  authorBn    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  titleBn   String?
  url       String
  publicId  String?
  videoUrl  String?
  videoPriority String @default("image")
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  nameBn    String?
  role      String
  roleBn    String?
  bio       String?  @db.Text
  bioBn     String?  @db.Text
  image     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  nameBn    String?
  quote     String   @db.Text
  quoteBn   String?  @db.Text
  program   String?
  programBn String?
  image     String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Volunteer {
  id           String          @id @default(cuid())
  fullName     String
  email        String
  phone        String
  address      String?
  profession   String?
  skills       String[]
  interest     String[]
  availability String?
  message      String?         @db.Text
  status       VolunteerStatus @default(PENDING)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum VolunteerStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
}

model Donor {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  phone      String?
  address    String?
  totalGiven Decimal    @default(0)
  donations  Donation[]
  createdAt  DateTime   @default(now())
}

model Donation {
  id            String         @id @default(cuid())
  donorName     String
  donorEmail    String
  donorPhone    String?
  amount        Decimal
  currency      String         @default("BDT")
  method        PaymentMethod
  transactionId String?
  programId     String?
  program       Program?       @relation(fields: [programId], references: [id])
  status        DonationStatus @default(PENDING)
  isRecurring   Boolean        @default(false)
  frequency     String?
  message       String?
  donorId       String?
  donor         Donor?         @relation(fields: [donorId], references: [id])
  createdAt     DateTime       @default(now())
}

enum PaymentMethod {
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  STRIPE
  PAYPAL
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  questionBn String?
  answer    String   @db.Text
  answerBn  String?  @db.Text
  category  String?
  categoryBn String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  titleBn   String?
  content   String   @db.Text
  contentBn String?  @db.Text
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model PaymentMethodConfig {
  id           String   @id @default(cuid())
  name         String
  nameBn       String?
  type         String
  accountInfo  String?
  instructions String?  @db.Text
  instructionsBn String? @db.Text
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DonationImpact {
  id        String   @id @default(cuid())
  icon      String   @default("💝")
  amount    Int
  impact    String
  impactBn  String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentItem {
  id          String   @id @default(cuid())
  section     String
  icon        String?
  title       String?
  titleBn     String?
  description String?  @db.Text
  descriptionBn String? @db.Text
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
